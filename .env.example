# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in values. `.env` is git-ignored.
# The app runs fully in mock mode with an empty DEEPSEEK_API_KEY.
# ---------------------------------------------------------------------------

# HTTP port for the Express API
PORT=8787

# Which LLM provider to use: "mock" (default, free, no network) or "deepseek"
LLM_PROVIDER=mock

# ---------------------------------------------------------------------------
# DeepSeek provider (only used when LLM_PROVIDER=deepseek)
# Leave DEEPSEEK_API_KEY empty to keep the app on the mock provider.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Current model IDs: deepseek-flash (recommended) or deepseek-v4-pro.
# Do NOT use deepseek-chat / deepseek-reasoner: retired 2026-07-24.
DEEPSEEK_MODEL=deepseek-flash

# V4 enables thinking mode by default, which spends the token budget on
# reasoning before answering. "disabled" keeps chat replies short and cheap.
DEEPSEEK_THINKING=disabled

# ---------------------------------------------------------------------------
# Request limits
# ---------------------------------------------------------------------------
MAX_MESSAGE_CHARS=2000
MAX_HISTORY_MESSAGES=20
# Body size limit accepted by express.json() (e.g. 16kb)
MAX_BODY_BYTES=16kb

# ---------------------------------------------------------------------------
# Embeddable widget (all values here are PUBLIC — never put secrets here)
# ---------------------------------------------------------------------------
# Public widget id sent by the browser as X-Widget-Id (not a credential).
WIDGET_ID=wgt_public_demo
# Branding. Changes need a server restart, not a frontend rebuild.
WIDGET_COMPANY_NAME=Your Company
WIDGET_TITLE=
WIDGET_GREETING=
WIDGET_ACCENT_COLOR=#4f7cff
# right | left
WIDGET_POSITION=right
# Comma-separated origins allowed to embed /embed and call the API cross-origin.
# Empty = embedding restricted to this deployment's own origin only.
# Example: https://yourcompany.com,https://www.yourcompany.com
WIDGET_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Company knowledge (grounding)
# ---------------------------------------------------------------------------
# Directory relative to server/ that contains company/ and sample/ JSON corpora.
KNOWLEDGE_DIR=data
# Use the bundled SAMPLE dataset when server/data/company/ is empty.
# MUST be false in production.
KNOWLEDGE_ALLOW_SAMPLE=true
# Minimum retrieval relevance (0..1) before the model is consulted.
KNOWLEDGE_MIN_SCORE=0.3
# Max evidence documents per question.
KNOWLEDGE_MAX_DOCUMENTS=4
# Cache identical grounded answers (ms). 0 disables.
ANSWER_CACHE_TTL_MS=3600000
ANSWER_CACHE_MAX_ENTRIES=500

# ---------------------------------------------------------------------------
# Rate limiting (per process; use a shared store if you run >1 replica)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=30
RATE_LIMIT_MAX_PER_WIDGET=120

# ---------------------------------------------------------------------------
# Hosting
# ---------------------------------------------------------------------------
# Interface to bind. Use 0.0.0.0 on PaaS/containers.
HOST=0.0.0.0
# Set to true (or a hop count / subnet) ONLY when behind a trusted proxy,
# otherwise clients could spoof X-Forwarded-For and bypass per-IP limits.
TRUST_PROXY=false
